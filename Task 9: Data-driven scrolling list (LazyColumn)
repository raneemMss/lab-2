@Composable
fun CourseListScreen(courses: List<Course>) {
    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(LabColors.ScreenBackground)
            .padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        items(courses) { course ->
            Card(
                modifier = Modifier.fillMaxWidth()
            ) {
                Column(modifier = Modifier.padding(16.dp)) {
                    Text(text = course.code, style = MaterialTheme.typography.titleMedium)
                    Text(text = course.title, style = MaterialTheme.typography.bodyMedium)
                }
            }
        }
    }
}
